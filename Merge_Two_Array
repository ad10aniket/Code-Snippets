public class mergeTwoArrays {

public static void main (String [] args){

int[] a = {1, 3, 5, 7};
int[] b = {2, 4};

int[] merged = new int[a.length + b.length];
int index = 0;
int max = Math.max(a.length, b.length);

for (int i = 0; i < max; i++) {
    if (i < a.length) {
        merged[index++] = a[i];
    }
    if (i < b.length) {
        merged[index++] = b[i];
    }
}

}
}
